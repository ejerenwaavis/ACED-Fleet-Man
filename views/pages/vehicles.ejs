<%- include('../components/header', { title: 'Fleet Management' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Fleet Management</h1>
            <p class="mt-2 text-sm text-gray-700">A list of all vehicles in your fleet including their route, plate, and current status.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <button onclick="document.getElementById('addVehicleModal').showModal()" class="inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 cursor-pointer">
                <i class="fa-solid fa-plus mr-2"></i> Add Vehicle
            </button>
        </div>
    </div>

    <!-- Vehicles Table -->
    <div class="flex flex-col">
        <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg bg-white">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Truck & Route</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fuel / Oil</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th scope="col" class="relative px-6 py-3"><span class="sr-only">Edit</span></th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% vehicles.forEach(v => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-bold text-gray-900"><%= v.truckNumber %></div>
                                        <div class="text-sm text-gray-500">Route: <%= v.routeNumber %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900"><%= v.makeModel || 'N/A' %></div>
                                        <div class="text-sm text-gray-500">Plate: <%= v.licensePlate || 'N/A' %></div>
                                        <div class="text-xs text-gray-400">VIN: <%= v.vin || 'N/A' %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <span class="capitalize"><%= v.fuelType %></span>
                                        <div class="text-xs mt-1">Last Oil: <%= v.lastOilChange ? v.lastOilChange.toLocaleDateString() : 'Unknown' %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <% if (v.status === 'active') { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                                        <% } else if (v.status === 'maintenance') { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Maintenance</span>
                                        <% } else { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Inactive</span>
                                        <% } %>
                                        <% if (v.pendingMaintenance) { %>
                                            <i class="fa-solid fa-wrench text-red-500 ml-2" title="Pending Maintenance"></i>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <button onclick="openEditModal('<%= JSON.stringify(v).replace(/'/g, "\\'") %>')" class="text-brand-600 hover:text-brand-900 cursor-pointer" title="Edit Vehicle"><i class="fa-solid fa-pen-to-square"></i></button>
                                        <button onclick="showQrModal('<%= v.truckNumber %>', '<%= v.qrCode %>')" class="text-indigo-600 hover:text-indigo-900 ml-4 cursor-pointer" title="Display Barcode"><i class="fa-solid fa-barcode"></i></button>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (vehicles.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-8 text-center text-gray-500">No vehicles found in the fleet. Add one to get started!</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Vehicle Modal (<dialog>) -->
<dialog id="addVehicleModal" class="p-6 rounded-lg shadow-xl backdrop:bg-gray-800/60 w-full max-w-lg border-0 m-auto outline-none open:animate-fade-in">
    <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-medium text-gray-900">Add New Vehicle</h3>
        <button onclick="document.getElementById('addVehicleModal').close()" class="text-gray-400 hover:text-gray-500 cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form action="/api/vehicles" method="POST" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Truck Number *</label>
                <input type="text" name="truckNumber" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Route Number *</label>
                <input type="text" name="routeNumber" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700">Make / Model</label>
            <input type="text" name="makeModel" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="e.g. Ford Transit 250">
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">License Plate</label>
                <input type="text" name="licensePlate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">VIN</label>
                <input type="text" name="vin" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Fuel Type</label>
                <select name="fuelType" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
                    <option value="gas">Gas</option>
                    <option value="diesel">Diesel</option>
                    <option value="electric">Electric</option>
                    <option value="hybrid">Hybrid</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Status</label>
                <select name="status" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
                    <option value="active">Active</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" onclick="document.getElementById('addVehicleModal').close()" class="inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:text-sm cursor-pointer">Cancel</button>
            <button type="submit" class="inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-brand-600 text-base font-medium text-white hover:bg-brand-700 focus:outline-none sm:text-sm cursor-pointer">Save Vehicle</button>
        </div>
    </form>
</dialog>

<!-- Edit Vehicle Modal (<dialog>) -->
<dialog id="editVehicleModal" class="p-6 rounded-lg shadow-xl backdrop:bg-gray-800/60 w-full max-w-lg border-0 m-auto outline-none open:animate-fade-in">
    <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-medium text-gray-900">Edit Vehicle</h3>
        <button onclick="document.getElementById('editVehicleModal').close()" class="text-gray-400 hover:text-gray-500 cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form id="editVehicleForm" action="" method="POST" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Truck Number *</label>
                <input type="text" id="edit-truckNumber" name="truckNumber" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Route Number *</label>
                <input type="text" id="edit-routeNumber" name="routeNumber" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700">Make / Model</label>
            <input type="text" id="edit-makeModel" name="makeModel" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">License Plate</label>
                <input type="text" id="edit-licensePlate" name="licensePlate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">VIN</label>
                <input type="text" id="edit-vin" name="vin" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Fuel Type</label>
                <select id="edit-fuelType" name="fuelType" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
                    <option value="gas">Gas</option>
                    <option value="diesel">Diesel</option>
                    <option value="electric">Electric</option>
                    <option value="hybrid">Hybrid</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Status</label>
                <select id="edit-status" name="status" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm">
                    <option value="active">Active</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" onclick="document.getElementById('editVehicleModal').close()" class="inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:text-sm cursor-pointer">Cancel</button>
            <button type="submit" class="inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-brand-600 text-base font-medium text-white hover:bg-brand-700 focus:outline-none sm:text-sm cursor-pointer">Update Vehicle</button>
        </div>
    </form>
</dialog>

<!-- QR Code Display Modal (<dialog>) -->
<dialog id="qrModal" class="rounded-2xl shadow-2xl backdrop:bg-gray-900/70 w-[calc(100%-2rem)] max-w-sm border-0 m-auto outline-none p-0 overflow-hidden open:animate-fade-in">
    <div class="bg-gradient-to-br from-indigo-500 to-indigo-700 px-6 py-6 text-center">
        <h3 class="text-xl font-bold text-white mb-1 flex justify-center items-center gap-2">
            <i class="fa-solid fa-truck"></i> <span id="qr-truck-title">Truck Barcode</span>
        </h3>
        <p class="text-indigo-100 text-sm opacity-90">Driver Quick-Scan ID</p>
    </div>
    
    <div class="p-6 bg-white flex flex-col items-center">
        <div class="w-full bg-gray-50 p-4 rounded-xl border border-gray-100 shadow-inner flex justify-center items-center mb-6 min-h-[140px]">
            <img id="qr-img" src="" alt="Barcode" class="w-full max-w-[280px] h-auto object-contain mix-blend-multiply">
        </div>
        
        <div class="w-full flex flex-col space-y-3">
            <button onclick="window.print()" class="w-full inline-flex justify-center items-center rounded-xl shadow-md px-4 py-3.5 bg-indigo-600 text-base font-semibold text-white hover:bg-indigo-700 hover:shadow-lg focus:outline-none transition-all cursor-pointer">
                <i class="fa-solid fa-print mr-2"></i> Print Label
            </button>
            <button onclick="document.getElementById('qrModal').close()" class="w-full inline-flex justify-center items-center rounded-xl border border-gray-200 px-4 py-3 bg-white text-base font-semibold text-gray-700 hover:bg-gray-50 hover:border-gray-300 focus:outline-none transition-all cursor-pointer">
                Close
            </button>
        </div>
    </div>
</dialog>

<script>
function showQrModal(truckNum, qrDataUrl) {
    document.getElementById('qr-truck-title').innerText = 'Truck ' + truckNum;
    document.getElementById('qr-img').src = qrDataUrl;
    document.getElementById('qrModal').showModal();
}

function openEditModal(vehicleJson) {
    const vehicle = JSON.parse(vehicleJson);
    document.getElementById('editVehicleForm').action = '/api/vehicles/' + vehicle._id;
    document.getElementById('edit-truckNumber').value = vehicle.truckNumber || '';
    document.getElementById('edit-routeNumber').value = vehicle.routeNumber || '';
    document.getElementById('edit-makeModel').value = vehicle.makeModel || '';
    document.getElementById('edit-licensePlate').value = vehicle.licensePlate || '';
    document.getElementById('edit-vin').value = vehicle.vin || '';
    document.getElementById('edit-fuelType').value = vehicle.fuelType || 'gas';
    document.getElementById('edit-status').value = vehicle.status || 'active';
    
    document.getElementById('editVehicleModal').showModal();
}
</script>

<%- include('../components/footer') %>
