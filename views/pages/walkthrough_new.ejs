<%- include('../components/header', { title: 'Evening Walkthrough Log' }) %>

<script src="https://unpkg.com/lucide@latest"></script>

<!-- Sticky Header -->
<div class="sticky top-0 z-50 bg-slate-900 text-white p-4 shadow-md flex justify-between items-center">
    <div>
        <h1 class="text-xl font-bold">Evening Walkthrough</h1>
        <p class="text-sm text-slate-300">Vehicles Logged Today: <span id="loggedCount">0</span></p>
    </div>
    <a href="/dashboard" class="text-slate-300 hover:text-white"><i data-lucide="x"></i></a>
</div>

<!-- Swipeable Container -->
<div class="flex overflow-x-auto snap-x snap-mandatory h-[calc(100vh-80px)] bg-slate-100" id="truckCarousel">
    
    <% vehicles.forEach((vehicle, index) => { %>
        <div class="w-full flex-shrink-0 snap-center p-4 pt-6" id="slide-<%= index %>" data-vehicle-id="<%= vehicle._id %>">
            <div class="bg-white rounded-2xl shadow-lg p-6 max-w-md mx-auto h-full overflow-y-auto pb-32">
                
                <div class="flex justify-between items-center mb-8 border-b pb-4">
                    <div>
                        <p class="text-sm text-slate-500 uppercase font-bold tracking-wider">Route</p>
                        <p class="text-3xl font-black text-slate-800"><%= vehicle.routeNumber %></p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-slate-500 uppercase font-bold tracking-wider">Truck</p>
                        <p class="text-3xl font-black text-brand-600"><%= vehicle.truckNumber %></p>
                    </div>
                </div>

                <form class="walkthrough-form space-y-8" onsubmit="return false;">
                    
                    <!-- Asset Checklist -->
                    <div class="space-y-6">
                        <!-- Scanner -->
                        <div>
                            <p class="text-lg font-bold text-slate-800 mb-3">Scanner</p>
                            <div class="grid grid-cols-2 gap-4">
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all bg-emerald-50 border-emerald-500 text-emerald-700 shadow-sm" data-field="scanner" data-val="true" onclick="toggleCheck(this, 'scanner', true)">
                                    <i data-lucide="check-circle-2" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Present</span>
                                </button>
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all text-slate-500" data-field="scanner" data-val="false" onclick="toggleCheck(this, 'scanner', false)">
                                    <i data-lucide="x-circle" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Missing</span>
                                </button>
                            </div>
                            <input type="hidden" name="scanner" value="true" class="autosave-trigger">
                        </div>

                        <!-- Gas Card -->
                        <div>
                            <p class="text-lg font-bold text-slate-800 mb-3">Gas Card</p>
                            <div class="grid grid-cols-2 gap-4">
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all bg-emerald-50 border-emerald-500 text-emerald-700 shadow-sm" data-field="gasCard" data-val="true" onclick="toggleCheck(this, 'gasCard', true)">
                                    <i data-lucide="credit-card" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Present</span>
                                </button>
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all text-slate-500" data-field="gasCard" data-val="false" onclick="toggleCheck(this, 'gasCard', false)">
                                    <i data-lucide="x-circle" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Missing</span>
                                </button>
                            </div>
                            <input type="hidden" name="gasCard" value="true" class="autosave-trigger">
                        </div>

                        <!-- Batteries -->
                        <div>
                            <p class="text-lg font-bold text-slate-800 mb-3">Batteries</p>
                            <div class="grid grid-cols-2 gap-4">
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all bg-emerald-50 border-emerald-500 text-emerald-700 shadow-sm" data-field="batteries" data-val="true" onclick="toggleCheck(this, 'batteries', true)">
                                    <i data-lucide="battery-charging" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Docked</span>
                                </button>
                                <button type="button" class="toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all text-slate-500" data-field="batteries" data-val="false" onclick="toggleCheck(this, 'batteries', false)">
                                    <i data-lucide="battery-warning" class="mb-2 h-8 w-8"></i>
                                    <span class="font-bold">Issue</span>
                                </button>
                            </div>
                            <input type="hidden" name="batteries" value="true" class="autosave-trigger">
                        </div>
                    </div>

                    <!-- Maintenance Note Section -->
                    <div class="mt-8">
                        <button type="button" class="w-full border-2 border-dashed border-slate-300 rounded-xl py-4 text-slate-600 font-bold flex items-center justify-center hover:bg-slate-50" onclick="toggleMaintenance(this)">
                            <i data-lucide="plus-circle" class="mr-2"></i> Add Maintenance Note
                        </button>
                        
                        <div class="hidden maintenance-panel mt-4 space-y-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <textarea name="maintenanceNote" rows="3" class="w-full rounded-lg border-slate-300 shadow-sm p-3 focus:ring-brand-500 focus:border-brand-500 autosave-blur" placeholder="Describe the issue..."></textarea>
                            
                            <p class="font-bold text-slate-700 text-sm uppercase">Routing</p>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="flex items-center p-3 border border-slate-300 rounded-lg bg-white">
                                    <input type="radio" name="routing" value="internal" class="text-brand-600 focus:ring-brand-500 h-5 w-5 autosave-trigger">
                                    <span class="ml-2 font-medium text-slate-700">Internal</span>
                                </label>
                                <label class="flex items-center p-3 border border-slate-300 rounded-lg bg-white">
                                    <input type="radio" name="routing" value="mechanic" class="text-brand-600 focus:ring-brand-500 h-5 w-5 autosave-trigger">
                                    <span class="ml-2 font-medium text-slate-700">Mechanic</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    <% }) %>

</div>

<!-- Fixed Bottom Action Bar -->
<div class="fixed bottom-0 left-0 w-full bg-white border-t border-slate-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-50">
    <div class="max-w-md mx-auto flex gap-4">
        <button onclick="logVehicleAndNext()" class="w-full bg-slate-900 text-white text-lg font-bold py-5 rounded-2xl shadow-xl flex justify-center items-center active:scale-95 transition-transform">
            Log Vehicle & Next <i data-lucide="arrow-right" class="ml-2"></i>
        </button>
    </div>
</div>

<script>
    lucide.createIcons();
    const todayStr = new Date().toISOString().split('T')[0];

    function toggleCheck(btn, field, value) {
        const parent = btn.closest('.grid');
        parent.querySelectorAll('.toggle-btn').forEach(b => {
            b.className = 'toggle-btn border-2 border-slate-200 rounded-xl py-4 flex flex-col items-center justify-center transition-all text-slate-500 bg-white';
        });

        if (value === true) {
            btn.className = 'toggle-btn border-2 rounded-xl py-4 flex flex-col items-center justify-center transition-all bg-emerald-50 border-emerald-500 text-emerald-700 shadow-sm';
        } else {
            btn.className = 'toggle-btn border-2 rounded-xl py-4 flex flex-col items-center justify-center transition-all bg-rose-50 border-rose-500 text-rose-700 shadow-sm';
        }

        const input = parent.parentElement.querySelector(`input[name="${field}"]`);
        input.value = value;
        triggerAutosave(input.closest('.snap-center'));
    }

    function toggleMaintenance(btn) {
        const panel = btn.nextElementSibling;
        panel.classList.toggle('hidden');
        btn.classList.toggle('hidden');
    }

    async function triggerAutosave(slideEl, status = 'draft') {
        const vehicleId = slideEl.dataset.vehicleId;
        const form = slideEl.querySelector('form');
        
        const data = {
            vehicleId,
            date: todayStr,
            status,
            checks: {
                scanner: form.scanner.value === 'true',
                gasCard: form.gasCard.value === 'true',
                batteries: form.batteries.value === 'true'
            },
            maintenanceNote: form.maintenanceNote.value
        };

        const routingEl = form.querySelector('input[name="routing"]:checked');
        if (routingEl) data.routing = routingEl.value;

        try {
            await fetch('/api/walkthrough/evening/autosave', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
        } catch (e) {
            console.error('Autosave failed', e);
        }
    }

    document.querySelectorAll('.autosave-blur').forEach(el => {
        el.addEventListener('blur', (e) => triggerAutosave(e.target.closest('.snap-center')));
    });
    document.querySelectorAll('.autosave-trigger').forEach(el => {
        el.addEventListener('change', (e) => triggerAutosave(e.target.closest('.snap-center')));
    });

    let currentIndex = 0;
    const slides = document.querySelectorAll('.snap-center');
    let loggedCount = 0;

    function logVehicleAndNext() {
        if (currentIndex >= slides.length) return;
        
        const currentSlide = slides[currentIndex];
        triggerAutosave(currentSlide, 'completed');
        
        loggedCount++;
        document.getElementById('loggedCount').innerText = loggedCount;

        const btn = document.querySelector('button[onclick="logVehicleAndNext()"]');
        btn.classList.add('bg-emerald-600');
        setTimeout(() => btn.classList.remove('bg-emerald-600'), 300);

        currentIndex++;
        if (currentIndex < slides.length) {
            slides[currentIndex].scrollIntoView({ behavior: 'smooth' });
        } else {
            btn.innerHTML = 'All Done! <i data-lucide="check-circle" class="ml-2"></i>';
            lucide.createIcons();
            setTimeout(() => window.location.href = '/dashboard', 1500);
        }
    }
</script>

</body>
</html>
