<%- include('../components/header', { title: 'ACED Fleet Man - Home' }) %>

<div class="relative bg-white overflow-hidden h-full flex flex-col justify-center py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
        <div class="lg:grid lg:grid-cols-12 lg:gap-8">
            <div class="sm:text-center md:max-w-2xl md:mx-auto lg:col-span-6 lg:text-left flex flex-col justify-center">
                <h1>
                    <span class="block text-sm font-semibold uppercase tracking-wide text-gray-500 sm:text-base lg:text-sm xl:text-base">Introducing</span>
                    <span class="mt-1 block text-4xl tracking-tight font-extrabold sm:text-5xl xl:text-6xl">
                        <span class="block text-gray-900">Next-generation</span>
                        <span class="block text-brand-600">Fleet Management</span>
                    </span>
                </h1>
                <p class="mt-3 text-base text-gray-500 sm:mt-5 sm:text-xl lg:text-lg xl:text-xl">
                    Streamline your maintenance routines, optimize routing, and take control of your entire fleet with the ACED Fleet Manager platform. Built for speed and reliability.
                </p>
                <div class="mt-8 sm:max-w-lg sm:mx-auto sm:text-center lg:text-left lg:mx-0">
                    <p class="text-base font-medium text-gray-900">Sign in to your account</p>
                    <form action="#" method="POST" class="mt-3 sm:flex">
                        <label for="email" class="sr-only">Email</label>
                        <input type="email" name="email" id="email" class="block w-full border-gray-300 rounded-md py-3 px-4 text-base placeholder-gray-500 shadow-sm focus:ring-brand-500 focus:border-brand-500 border" placeholder="Enter your email">
                        <button type="submit" class="mt-3 w-full px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-brand-600 shadow-sm hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 sm:mt-0 sm:ml-3 sm:flex-shrink-0 sm:inline-flex sm:items-center sm:w-auto transition-colors">
                            Continue
                        </button>
                    </form>
                    <p class="mt-3 text-sm text-gray-500">
                        Require an account? Contact your <a href="#" class="font-medium text-gray-900 underline">administrator</a>.
                    </p>
                </div>
            </div>
            <div class="mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0 lg:col-span-6 lg:flex lg:items-center">
                <div class="relative mx-auto w-full rounded-lg shadow-lg lg:max-w-md">
                    <div class="relative block w-full bg-white rounded-lg overflow-hidden border border-gray-200">
                        <div class="w-full h-64 bg-gray-100 flex items-center justify-center relative">
                             <!-- Decorative background pattern -->
                             <svg class="absolute inset-0 w-full h-full text-gray-200" fill="currentColor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                <polygon points="0,100 100,0 100,100" />
                              </svg>
                             <i class="fa-solid fa-truck-fast text-brand-600 text-9xl opacity-80 drop-shadow-md z-10 transition-transform hover:scale-110 duration-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../components/footer') %>
